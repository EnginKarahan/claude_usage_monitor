msgid "Claude Usage Monitor"
msgstr "Claude Kullanım İzleyici"

#, qt-format
msgid "Error: %1"
msgstr "Hata: %1"

msgid "Waiting for first poll…"
msgstr "İlk veri alımı bekleniyor…"

#, qt-format
msgid "<b>Session (5h)</b>: %1% used, projected %2 at reset in %3<br/><i>%4</i>"
msgstr "<b>Oturum (5sa)</b>: %1 kullanıldı, %3 sonra sıfırlamada %2 tahmini<br/><i>%4</i>"

#, qt-format
msgid "<b>Weekly (7d)</b>: %1% used, projected %2 at reset in %3<br/><i>%4</i>"
msgstr "<b>Haftalık (7g)</b>: %1 kullanıldı, %3 sonra sıfırlamada %2 tahmini<br/><i>%4</i>"

msgid "<small>Click to expand · Middle-click to refresh</small>"
msgstr "<small>Genişletmek için tıkla · Yenilemek için orta tıkla</small>"

#, qt-format
msgid "⚠ %1"
msgstr "⚠ %1"

msgid "Session (5-hour window)"
msgstr "Oturum (5 saatlik pencere)"

msgid "Weekly (7-day window)"
msgstr "Haftalık (7 günlük pencere)"

#, qt-format
msgid "Last poll: %1 · Plan: %2"
msgstr "Son sorgu: %1 · Plan: %2"

msgid "Refresh"
msgstr "Yenile"

msgid "no data"
msgstr "veri yok"

msgid "Used now"
msgstr "Şu anki kullanım"

msgid "Projected at reset"
msgstr "Sıfırlamada tahmini"

#, qt-format
msgid "%1 (no rate yet)"
msgstr "%1 (henüz hız yok)"

msgid "Burn rate"
msgstr "Tüketim hızı"

msgid "Reset in"
msgstr "Sıfırlamaya"

msgid "under-utilized — tokens may be wasted"
msgstr "yetersiz kullanım — tokenlar boşa gidebilir"

msgid "on track"
msgstr "yolunda"

msgid "approaching limit"
msgstr "limite yaklaşıyor"

msgid "projected to exceed limit"
msgstr "limit aşılacak"

msgid "unknown"
msgstr "bilinmiyor"
