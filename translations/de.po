msgid "Claude Usage Monitor"
msgstr "Claude-Nutzungsanzeige"

#, qt-format
msgid "Error: %1"
msgstr "Fehler: %1"

msgid "Waiting for first poll…"
msgstr "Warte auf ersten Datenabruf…"

#, qt-format
msgid "<b>Session (5h)</b>: %1% used, projected %2 at reset in %3<br/><i>%4</i>"
msgstr "<b>Sitzung (5 h)</b>: %1 % verbraucht, Prognose %2 bei Reset in %3<br/><i>%4</i>"

#, qt-format
msgid "<b>Weekly (7d)</b>: %1% used, projected %2 at reset in %3<br/><i>%4</i>"
msgstr "<b>Woche (7 d)</b>: %1 % verbraucht, Prognose %2 bei Reset in %3<br/><i>%4</i>"

msgid "<small>Click to expand · Middle-click to refresh</small>"
msgstr "<small>Klick öffnet Details · Mittelklick aktualisiert</small>"

#, qt-format
msgid "⚠ %1"
msgstr "⚠ %1"

msgid "Session (5-hour window)"
msgstr "Sitzung (5-Stunden-Fenster)"

msgid "Weekly (7-day window)"
msgstr "Woche (7-Tage-Fenster)"

#, qt-format
msgid "Last poll: %1 · Plan: %2"
msgstr "Letzter Abruf: %1 · Plan: %2"

msgid "Refresh"
msgstr "Aktualisieren"

msgid "Refreshing…"
msgstr "Wird aktualisiert…"

msgid "no data"
msgstr "keine Daten"

msgid "Used now"
msgstr "Aktuell verbraucht"

msgid "Projected at reset"
msgstr "Prognose bei Reset"

#, qt-format
msgid "%1 (no rate yet)"
msgstr "%1 (noch keine Rate)"

msgid "Burn rate"
msgstr "Verbrauchsrate"

msgid "Reset in"
msgstr "Reset in"

msgid "under-utilized — tokens may be wasted"
msgstr "unterausgelastet — Tokens werden verschwendet"

msgid "on track"
msgstr "im Plan"

