[Unit]
Description=Periodic Claude usage poll for the KDE widget

[Timer]
# Run shortly after login, then every 20 minutes.
OnBootSec=2min
OnUnitActiveSec=20min
AccuracySec=60s
Persistent=true
Unit=claude-widget-poll.service

[Install]
WantedBy=timers.target
